                                                                    <div class="job-detail-qualifications" name="OZETBILGI">
                                                                        <p>
                                                                            @item.description
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="aligment-container my-3">
                                                        <header>
                                                            <h2></h2>
                                                        </header>
                                                        <section>




                                                            <div class="aligment-container-section">
                                                                <label class="d-none d-sm-inline-block">
                                                                    <h5>Bolüm</h5>
                                                                    <span class="value-contain" name="BOLUM">@item.Position</span>
                                                                </label>
                                                            </div>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                        </div>
                                    </div>


                                }


                            </div>
                        </div>
                    </div>
                </div>


            </div>
