                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" name="ILANBASLIK">İlan Başlığı</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                aria-label="Kapat">
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="col-16 col-sm-7 col-md-7 col-lg-8 p-0 mb-0 col">
                                                            <div class="overflow-hidden k-shadow k-radius">
                                                                <div class="bg-white">
                                                                    <div class="main-container">
