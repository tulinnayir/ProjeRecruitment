                                                                                                    @item.title
                                                                                                </span>
                                                                                            </span>
                                                                                        </p>
                                                                                        <p name="Durum">
                                                                                            @item.status
                                                                                        </p>



                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="headline-bottom justify-content-between d-flex">
                                                                                @* <div class="mb-md-3 mb-lg-0 align-items-center ad-subdetail mb-0 mb-sm-0 d-flex">
                                                                            <div class="company-location">
                                                                            <span name="IL">@item</span>
                                                                            </div>
                                                                            <div class="align-items-center d-none d-md-flex">
                                                                            <div class="dot-icon mx-2"></div>
                                                                            <p class="mb-0">
                                                                            </div> *@
                                                                            </div>
                                                                            <div class="mb-md-3 mb-lg-0 align-items-center ad-subdetail mb-0 mb-sm-0 d-flex">
                                                                                @*  <div class="company-location">
                                                                            <span name="ILCE">
                                                                            @item
                                                                            </span>
                                                                            </div> *@
                                                                                <div class="align-items-center d-none d-md-flex">
                                                                                    <div class="dot-icon mx-2"></div>
                                                                                    <p class="mb-0">
                                                                                </div>
                                                                            </div>
                                                                            <div class="">
                                                                                <div class="updated-date">
                                                                                    <span id="updateDate" name="ADRES">
                                                                                        @item.JobLocation
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="details-container p-3 mt-sm-0">
                                                                        @*  <div class="details d-none d-lg-flex p-3 py-sm-4 flex-lg-row">
                                                                    <div class="detail mb-3 mb-sm-0 flex-sm-column">
                                                                    <h6 class="mb-1">
                                                                    Çalışma Şekli
                                                                    </h6>
                                                                    <p class="mb-0" name="">

                                                                    </p>
                                                                    </div> *@
                                                                        @*  <div class="detail mb-2 mb-sm-0 flex-sm-column">
                                                                    <h6 class="mb-1">
                                                                    Askerlik
                                                                    </h6>
                                                                    <p class="mb-0" name="">
                                                                    Yapıldı
                                                                    </p>
                                                                    </div> *@
                                                                        @*   <div class="detail mb-2 mb-sm-0 flex-sm-column">
                                                                    <h6 class="mb-1">
                                                                    Çalışma Tercihi
                                                                    </h6>
                                                                    <p class="mb-0 d-none d-xl-inline" name="">
                                                                    Hibrit
                                                                    </p>
                                                                    </div> *@
                                                                        <br />                                                                   @*  <div class="detail mb-2 mb-sm-0 flex-sm-column">
                                                                    <h6 class="mb-1">
                                                                    Ehliyet
                                                                    </h6>
                                                                    <p class="mb-0 d-none d-xl-inline" name="">
                                                                    Yok
                                                                    </p>
                                                                    </div> *@
                                                                        <div class="detail mb-2 mb-sm-0 flex-sm-column">
                                                                            <h6 class="mb-1">
                                                                                Departman
                                                                            </h6>
                                                                            @item.Department
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="job-container my-3">
