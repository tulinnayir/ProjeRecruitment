@model EntityLayer.Concrete.Users


@{
    ViewBag.Title = "UserUyelik";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/assets/kayitgiris.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <title>Login Page</title>
</head>
<body>
    <div class="container" id="container">
        <div class="form-container sign-up">
           
            <form method="post" asp-controller="User" asp-action="UserInsert">
                <div class="fr-contain">
                    <h1>Create Account </h1>

                    <input type="text" placeholder="Name" name="name" asp-for="@Model.name">
                    <input type="text" placeholder="Soyad" name="surname" asp-for="@Model.surname">
                    <input type="email" placeholder="Eposta" name="mail" asp-for="@Model.mail">
                    <input type="password" placeholder="Password" name="password" asp-for="@Model.password">
                    <input type="tel" placeholder="Tel" name="phone" asp-for="@Model.phone">
                    <input type="text" placeholder="Açıklama" name="explanation" asp-for="@Model.explanation">
                    <input type="date" placeholder="Doğum Tarihi" name="date_birth" asp-for="@Model.date_birth">
                    <input type="text" placeholder="Okul Adı" name="school_name" asp-for="@Model.school_name">
                    <input type="text" placeholder="İş Adı" name="job_name" asp-for="@Model.job_name">
                    <input type="text" placeholder="Not" name="note" asp-for="@Model.note">
                    <input type="text" placeholder="Bölüm" name="major" asp-for="@Model.major">
                    <input type="date" placeholder="Başlangıç Tarihi" name="start_date" asp-for="@Model.start_date">
                    <input type="date" placeholder="Bitiş Tarihi" name="end_date" asp-for="@Model.end_date">
                    <input type="text" placeholder="Cinsiyet" name="gender" asp-for="@Model.gender">
                    <input type="url" placeholder="Link" name="link" asp-for="@Model.link">

                    <button type="submit">Sign Up</button>
                </div>
            </form>
        </div>
        <div class="form-container sign-in">
            <form method="post" asp-controller="User" asp-action="UserProfil">
                <h1>Sign In</h1>
                @* <div class="social-icons">
                <a href="#" class="icon"><i class="fa-brands fa-linkedin"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" class="icon"><i class="fa-brands fa-google"></i></a>
                </div> *@
                @* <span>or use your email password</span> *@
                <input type="email" name="mail" placeholder="Email">
                <input type="password" name="password" placeholder="Password">
                <a href="/forgot-password">Forgot Your Password?</a>
                <button type="submit">Sign In</button>
            </form>
        </div>
        <div class="toggle-container">
            <div class="toggle">
                <div class="toggle-panel toggle-left">
                    <h1>Welcome Back!</h1>
                    <p>Register with your personal details to use all of the site features</p>
                    <button class="hidden" id="login">Sign In</button>




                </div>
                <div class="toggle-panel toggle-right">
                    <h1>Hello, Adventurer!</h1>
                    <p>Enter your personal details to use all of the site features</p>
                    <button class="hidden" id="register">Sign Up</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/kayitgiris.js"></script>
</body>
</html>
