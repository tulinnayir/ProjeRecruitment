@model EntityLayer.Concrete.JobAdverts

@{
    ViewBag.Title = "ilanAc";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link href="~/assets/ilanAc.css" rel="stylesheet" />

    <title>İlan Aç</title>
</head>
<body>
    <div class="formbold-main-wrapper">
        <div class="formbold-form-wrapper">
            <div class="formbold-form-title">
                <h2>İlan Aç</h2>
            </div>

     

            <form method="post" asp-controller="Sirket" asp-action="IlanAc">
                <div class="form-row">
                    <div class="formbold-mb-3 col-md-6">
                        <label for="ILANBASLIK" class="formbold-form-label">İlan Başlık</label>
                        <input type="text" name="title" id="ILANBASLIK" asp-for="@Model.title" class="formbold-form-input" />
                    </div>
                    <div class="formbold-mb-3 col-md-6">
                        <label for="ISKONUM" class="formbold-form-label">İş Konumu</label>
                        <input type="text" name="JobLocation" id="ISKONUM" asp-for="@Model.JobLocation" class="formbold-form-input" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="formbold-mb-3 col-md-6">
                        <label for="POZISYON" class="formbold-form-label">Pozisyonu</label>
                        <input type="text" name="Position" id="POZISYON" asp-for="@Model.Position" class="formbold-form-input" />
                    </div>
                    <div class="formbold-mb-3 col-md-6">
                        <label for="SEVIYE" class="formbold-form-label">Seviye</label>
                        <input type="text" name="Level" id="SEVIYE" asp-for="@Model.Level" class="formbold-form-input" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="formbold-mb-3 col-md-6">
                        <label for="ILANBITMETARIH" class="formbold-form-label">İlan Bitme Tarihi</label>
                        <input type="date" name="advert_end_date" asp-for="@Model.advert_end_date" id="ILANBITMETARIH" class="formbold-form-input" />
                    </div>
                    <div class="formbold-mb-3 col-md-6">
                        <label for="DEPARTMAN" class="formbold-form-label">Departman</label>
                        <input type="text" name="Department" asp-for="@Model.Department" id="DEPARTMAN" class="formbold-form-input" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="formbold-mb-3 col-md-6">
                        <label for="TECRUBE" class="formbold-form-label">Tecrübe</label>
                        <input type="text" name="Experience" asp-for="@Model.Experience" id="TECRUBE" class="formbold-form-input" />
                    </div>
                    <div class="formbold-mb-3 col-md-6">
                        <label for="EGITIMSEVIYE" class="formbold-form-label">Eğitim Seviyesi</label>
                        <input type="text" name="EducationLevel" asp-for="@Model.EducationLevel" id="EGITIMSEVIYE" class="formbold-form-input" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="formbold-mb-3 col-md-6">
                        <label for="ASKERLIK" class="formbold-form-label">Askerlik</label>
                        <input type="text" name="MilitaryStatus" asp-for="@Model.MilitaryStatus" id="ASKERLIK" class="formbold-form-input" />
                    </div>
                    <div class="formbold-mb-3 col-md-6">
                        <label for="CALISMASEKIL" class="formbold-form-label">Çalışma Şekli</label>
                        <input type="text" name="type_of_work" asp-for="@Model.type_of_work" id="CALISMASEKIL" class="formbold-form-input" />
                    </div>
                </div>

                <div class="formbold-mb-3">
                    <label for="ILANACIKLAMA" class="formbold-form-label">İlan Açıklama</label>
                    <textarea name="description" id="ILANACIKLAMA" asp-for="@Model.description" class="formbold-form-textarea" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Gönder</button>
            </form>

        </div>
    </div>

    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7HUp9K/ScQsAP7HUp9K" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

</body>
</html>
