    <!-- Template Javascript -->
    <script src="~/js/sirketadaygoruntulemedetay.js"></script>
    <script>
   





        function toggleDropdown(dropdownId) {
            const dropdown = document.getElementById(dropdownId);
            if (dropdown.style.display === "none" || dropdown.style.display === "") {
                dropdown.style.display = "flex";
            } else {
                dropdown.style.display = "none";
            }
        }

        // Diğer fonksiyonlarınız burada
        function openDropdownsBasedOnChecked() {
            const positionDropdown = document.getElementById('dropdown-position');
            const skillDropdown = document.getElementById('dropdown-skill');
            const categoryDropdown = document.getElementById('dropdown-category');

            const positionChecked = document.querySelectorAll('#position-list input:checked').length > 0;
            const skillChecked = document.querySelectorAll('#skill-list input:checked').length > 0;
            const categoryChecked = document.querySelectorAll('#category-list input:checked').length > 0;

            positionDropdown.style.display = positionChecked ? 'flex' : 'none';
            skillDropdown.style.display = skillChecked ? 'flex' : 'none';
            categoryDropdown.style.display = categoryChecked ? 'flex' : 'none';
        }

        function filterOptions(inputId, listId) {
            const input = document.getElementById(inputId);
            const filter = input.value.toLowerCase();
            const list = document.getElementById(listId);
            const labels = list.getElementsByTagName('label');

            for (let i = 0; i < labels.length; i++) {
                const label = labels[i];
                const text = label.textContent || label.innerText;
                if (text.toLowerCase().indexOf(filter) > -1) {
                    label.style.display = '';
                } else {
                    label.style.display = 'none';
                }
            }
        }

        function toggleInputGroup(checkbox) {
            const container = document.getElementById('input-groups-container');
            const value = checkbox.value;
            if (checkbox.checked) {
                if (!document.getElementById(`input-group-${value}`)) {
                    const inputGroup = document.createElement('div');
                    inputGroup.className = 'input-group-container';
                    inputGroup.id = `input-group-${value}`;
                    inputGroup.innerHTML = `
                        <input type="number" name="Beg[]" placeholder="Beginner (1-10)" min="1" max="10">
                        <input type="number" name="Ju[]" placeholder="Junior (1-10)" min="1" max="10">
                        <input type="number" name="Mid[]" placeholder="Mid (1-10)" min="1" max="10">
                        <input type="number" name="Exper[]" placeholder="Experienced (1-10)" min="1" max="10">
                        <input type="number" name="Expert[]" placeholder="Expert (1-10)" min="1" max="10">
                    `;
                    container.appendChild(inputGroup);
                }
            } else {
                const inputGroup = document.getElementById(`input-group-${value}`);
                if (inputGroup) {
                    container.removeChild(inputGroup);
                }
            }
        }

        function filterSkillsByPosition() {
            const selectedPositions = Array.from(document.querySelectorAll('#position-list input:checked')).map(checkbox => checkbox.value);
            const skills = document.getElementById('skill-list').getElementsByTagName('label');

            for (let i = 0; i < skills.length; i++) {
                const skill = skills[i];
                const job = skill.querySelector('input').dataset.job;
                if (selectedPositions.length === 0 || selectedPositions.includes(job)) {
                    skill.style.display = '';
                } else {
                    skill.style.display = 'none';
                }
            }
        }

        function filterCategoriesBySkill() {
            const selectedSkills = Array.from(document.querySelectorAll('#skill-list input:checked')).map(checkbox => checkbox.value);
            const categories = document.getElementById('category-list').getElementsByTagName('label');

            for (let i = 0; i < categories.length; i++) {
                const category = categories[i];
                const cat = category.querySelector('input').dataset.cat;
                if (selectedSkills.length === 0 || selectedSkills.includes(cat)) {
                    category.style.display = '';
                } else {
                    category.style.display = 'none';
                }
            }
        }

        function initialize() {
            // Pozisyon ve Yetkinlik filtreleme işlemlerini checkbox'ların değişim olaylarına bağlama
            document.querySelectorAll('#position-list input').forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    filterSkillsByPosition();
                    openDropdownsBasedOnChecked();
                });
            });
            document.querySelectorAll('#skill-list input').forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    filterCategoriesBySkill();
                    openDropdownsBasedOnChecked();
                });
            });
            document.querySelectorAll('#category-list input').forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    toggleInputGroup(this);
                    openDropdownsBasedOnChecked();
                });
            });

            // Sayfa yüklendiğinde açılır menüleri kontrol et ve filtrelemeleri uygula
            openDropdownsBasedOnChecked();
            filterSkillsByPosition();
            filterCategoriesBySkill();

            // Başlangıçta seçili kategorilere göre input-group'ları oluştur
            document.querySelectorAll('#category-list input:checked').forEach(checkbox => {
                toggleInputGroup(checkbox);
            });
        }

        // Sayfa yüklendiğinde başlat
        window.addEventListener('load', initialize);







        document.querySelector('form').addEventListener('submit', function (event) {
            // Formun gönderimini engelle
            event.preventDefault();

            // Formdaki seçili değerleri oku
            const ISTUR = getSelectedValues('position-list');
            const YETKINLIK = getSelectedValues('skill-list');
            const ALTKATEGOR = getSelectedValues('category-list');

            const begValues = getAllInputValues('Beg');
            const juValues = getAllInputValues('Ju');
            const midValues = getAllInputValues('Mid');
            const experValues = getAllInputValues('Exper');
            const expertValues = getAllInputValues('Expert');

            // URL parametrelerini oluştur
            const queryParams = new URLSearchParams({
                ISTUR: ISTUR.join(','),
                YETKINLIK: YETKINLIK.join(','),
                ALTKATEGOR: ALTKATEGOR.join(','),
                Beg: begValues.join(','),
                Ju: juValues.join(','),
                Mid: midValues.join(','),
                Exper: experValues.join(','),
                Expert: expertValues.join(',')
            });

            // URL'yi güncelle
            const url = `SirketAdayGoruntulemeDetay?${queryParams.toString()}`;
            window.location.href = url;
        });

        function getSelectedValues(listId) {
            const checkboxes = document.querySelectorAll(`#${listId} input:checked`);
            return Array.from(checkboxes).map(checkbox => checkbox.value);
        }

        function getAllInputValues(namePrefix) {
            const inputs = document.querySelectorAll(`input[name^="${namePrefix}"]`);
            return Array.from(inputs).map(input => input.value || 0);
        }

        function fillCheckboxListFromParams(paramName, listId) {
            const urlParams = new URLSearchParams(window.location.search);
            const values = urlParams.get(paramName)?.split(',') || [];
            const checkboxes = document.querySelectorAll(`#${listId} input`);

            checkboxes.forEach(checkbox => {
                if (values.includes(checkbox.value)) {
                    checkbox.checked = true;
                    toggleInputGroup(checkbox); // Gerekirse input grubunu da göster
                }
            });
        }
    </script>
    
